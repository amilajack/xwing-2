{
  "name": "rogue-vector",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:sketchfab": "node scripts/fetch-sketchfab-assets.mjs",
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "test": "pnpm test:coop && node --test tests/device-tilt.test.mjs tests/ship-motion.test.mjs tests/maneuvers.test.mjs tests/combat.test.mjs tests/asteroid-wrap.test.mjs && pnpm run build && node --test tests/rendered-html.test.mjs",
    "verify:browser": "PLAYWRIGHT_HEADED=1 node scripts/verify-game-playwright.mjs",
    "verify:browser:headless": "node scripts/verify-game-playwright.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:format": "git diff --check && git diff --cached --check",
    "check": "pnpm db:generate && pnpm run check:format && pnpm run lint && pnpm run typecheck && pnpm test",
    "preinstall": "node scripts/require-pnpm.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "server:dev": "tsx server/index.ts",
    "server:build": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.mjs",
    "test:coop": "tsx --test tests/coop.test.ts tests/versus.test.ts",
    "verify:coop": "node scripts/verify-coop-playwright.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:load": "node scripts/load-coop.mjs",
    "verify:coop:live": "node scripts/verify-coop-live.mjs",
    "verify:coop:lobby": "node scripts/verify-coop-lobby.mjs",
    "verify:versus": "node scripts/verify-versus-playwright.mjs",
    "verify:versus:persistence": "tsx scripts/verify-versus-persistence.mjs",
    "verify:coop:protocol": "node scripts/verify-coop-protocol.mjs"
  },
  "dependencies": {
    "@fails-components/webtransport": "^1.6.11",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.11",
    "@prisma/client": "^6.19.3",
    "next": "^16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@gltf-transform/cli": "^4.4.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.62.0",
    "prisma": "^6.19.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0"
}
